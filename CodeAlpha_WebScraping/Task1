import requests
from bs4 import BeautifulSoup
import pandas as pd

# 1. Tentukan URL target
url = "http://books.toscrape.com/"

# 2. "Kunjungi" website menggunakan requests
# Kita tambahkan 'headers' agar website mengira kita adalah browser manusia (bukan bot)
headers = {
    "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/91.0.4472.124 Safari/537.36"
}

response = requests.get(url, headers=headers)

# Cek apakah berhasil (Status code 200 = OK)
if response.status_code == 200:
    print("✅ Berhasil mengunduh halaman web!")
else:
    print(f"❌ Gagal mengunduh halaman. Status code: {response.status_code}")

# 3. "Baca" halaman web menggunakan BeautifulSoup
soup = BeautifulSoup(response.text, 'html.parser')

# 4. Temukan data yang kita cari
# (Kita akan mencari semua elemen <article> dengan class 'product_pod')
buku_list = soup.find_all('article', class_='product_pod')

# Siapkan list kosong untuk menampung data
data_buku = []

# 5. Looping (perulangan) untuk mengambil data dari setiap buku
for buku in buku_list:
    # Ambil Judul (ada di dalam tag <h3> -> <a> -> atribut 'title')
    judul = buku.h3.a['title']
    
    # Ambil Harga (ada di dalam tag <p> dengan class 'price_color')
    harga = buku.find('p', class_='price_color').text
    
    # Ambil Status Stok (ada di dalam tag <p> dengan class 'instock availability')
    # .strip() digunakan untuk menghapus spasi/enter yang tidak perlu
    stok = buku.find('p', class_='instock availability').text.strip()
    
    # Ambil Rating (ada di dalam tag <p> yang memiliki class seperti 'star-rating Three')
    # Kita ambil class kedua, misal 'Three', 'Four', dll.
    rating_class = buku.find('p', class_='star-rating')['class'][1]
    
    # Masukkan ke dalam dictionary, lalu tambahkan ke list utama
    data_buku.append({
        'Judul': judul,
        'Harga': harga,
        'Rating': rating_class,
        'Stok': stok
    })

# 6. Ubah list menjadi DataFrame Pandas agar rapi
df = pd.DataFrame(data_buku)

# 7. Simpan ke file CSV
df.to_csv('scraping_book.csv', index=False, encoding='utf-8')

print(f"\n🎉 Selesai! Berhasil mengambil {len(df)} data buku.")
print("Silakan cek file 'scraping_book.csv' di folder kamu.")
print("\nPreview 5 data pertama:")
print(df.head())